<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chic_white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/uploader_status"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/chic_black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_label" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_unknown" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/last_run_label" />

        <TextView
            android:id="@+id/txtLastRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/never" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pending_files_label" />

        <TextView
            android:id="@+id/txtPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/last_upload_result_label" />

        <TextView
            android:id="@+id/txtLastResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_uploads_yet" />

        <Button
            android:id="@+id/btnRunNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/chic_black"
            android:textColor="@color/chic_white"
            android:text="@string/run_upload_now" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings"
            android:backgroundTint="@color/chic_black"
            android:textColor="@color/chic_white" />

    </LinearLayout>
</ScrollView>
