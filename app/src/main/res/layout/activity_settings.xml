<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chic_white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_folder"
            android:backgroundTint="@color/chic_black"
            android:textColor="@color/chic_white" />

        <TextView
            android:id="@+id/txtFolderPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_saf_permission"
            android:textColor="@color/chic_black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtFolderPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/folder_path_label"
            android:textColor="@color/chic_black"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_textbox_solid_border"
            android:hint="@string/phone_number_hint"
            android:inputType="phone"
            android:maxLength="10"
            android:paddingHorizontal="6dp"
            android:paddingVertical="5dp"
            android:textColor="@color/chic_black"
            android:textColorHint="@color/chic_gray" />

        <EditText
            android:id="@+id/edtIntervalMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_textbox_solid_border"
            android:hint="@string/upload_interval_hint"
            android:inputType="number"
            android:paddingHorizontal="6dp"
            android:paddingVertical="5dp"
            android:textColor="@color/chic_black"
            android:textColorHint="@color/chic_gray" />

        <EditText
            android:id="@+id/edtServerBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_textbox_solid_border"
            android:hint="@string/server_base_url_hint"
            android:inputType="textUri"
            android:paddingHorizontal="6dp"
            android:paddingVertical="5dp"
            android:textColor="@color/chic_black"
            android:textColorHint="@color/chic_gray" />

        <EditText
            android:id="@+id/edtUploadEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_textbox_solid_border"
            android:hint="@string/upload_endpoint_hint"
            android:inputType="textUri"
            android:paddingHorizontal="6dp"
            android:paddingVertical="5dp"
            android:textColor="@color/chic_black"
            android:textColorHint="@color/chic_gray" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save"
            android:backgroundTint="@color/chic_black"
            android:textColor="@color/chic_white" />

    </LinearLayout>
</ScrollView>
