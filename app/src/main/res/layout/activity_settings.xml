<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chic_black"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnPickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/chic_white"
            android:text="Pick folder (used for scan + delete)"
            android:textColor="@color/chic_black" />

        <TextView
            android:id="@+id/txtFolderPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No SAF folder permission granted"
            android:textColor="@color/chic_white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtFolderPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Folder path: /storage/emulated/0/Recordings/Record/Call"
            android:textColor="@color/chic_white"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtIntervalMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/chic_white"
            android:hint="Upload interval (minutes)"
            android:inputType="number"
            android:textColor="@color/chic_white"
            android:textColorHint="@color/chic_gray" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/chic_white"
            android:text="Save"
            android:textColor="@color/chic_black" />

    </LinearLayout>
</ScrollView>
